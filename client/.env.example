# ============================================================================
# AI INTERACTIVE WORLD — Client Environment Variables Template
# ============================================================================

# Backend REST API Base URL
# In local development: http://localhost:3001/api
# In production: https://<your-backend-domain>/api
VITE_API_BASE_URL=http://localhost:3001/api

# Backend Server Root URL (Used for static files, photos, uploads)
# In local development: http://localhost:3001
# In production: https://<your-backend-domain>
VITE_SERVER_URL=http://localhost:3001

# Public Application Title & Branding
VITE_APP_TITLE="AI Interactive World — Science Exhibition 2026"
VITE_APP_DESCRIPTION="Science Exhibition 2026 Platform — Four Experiences. One Intelligent World."
VITE_EXHIBITION_NAME="Science Exhibition 2026"

# Exhibition Hardware & Turnover Settings
VITE_EXPO_MODE_TURNOVER_SEC=45
VITE_AUDIO_ENABLED=true
